<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">

    <title><%= typeof title !== 'undefined' ? title : "Unusual Military Aviation" %></title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        body {
            background: linear-gradient(160deg, #0a0a0a, #1a1a1a, #0d0d0d);
            background-attachment: fixed;
            color: #ddd;
        }

        .navbar {
            background-color: #111 !important;
            border-bottom: 1px solid #222;
        }

        .nav-link, .nav-link button {
            color: #ccc !important;
            font-size: 17px;
            margin-left: 10px;
            background: none;
            border: none;
        }

        .nav-link:hover {
            color: #fff !important;
        }

        /* === ВАЖНО: ФИКС КАРТИНОК САМОЛЁТОВ === */
        .plane-img {
            max-width: 900px;
            width: 100%;
            display: block;
            margin: 0 auto 20px auto;
            border-radius: 12px;
            border: 2px solid #333;
            box-shadow: 0 0 25px rgba(0,0,0,0.8);
        }

        footer {
            margin-top: 40px;
            padding: 25px;
            background: #111;
            text-align: center;
            color: #777;
            border-top: 1px solid #333;
        }
    </style>
</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark mb-4">
    <div class="container-fluid">

        <a class="navbar-brand" href="/">Aviation Project</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menu">
            <ul class="navbar-nav ms-auto align-items-center">

                <li class="nav-item"><a class="nav-link" href="/">Главная</a></li>
                <li class="nav-item"><a class="nav-link" href="/aircrafts/bi1">БИ-1</a></li>
                <li class="nav-item"><a class="nav-link" href="/aircrafts/ho229">Ho 229</a></li>
                <li class="nav-item"><a class="nav-link" href="/aircrafts/f117">F-117</a></li>

                <% if (user) { %>
                    <form action="/logout" method="post" class="d-inline">
                        <li class="nav-item">
                            <button type="submit" class="nav-link">
                                Выйти (<%= user.username %>)
                            </button>
                        </li>
                    </form>
                <% } else { %>
                    <li class="nav-item">
                        <a class="nav-link" href="/logreg">Войти</a>
                    </li>
                <% } %>

            </ul>
        </div>

    </div>
</nav>

<div class="container">
    <%- body %>
</div>

<footer>
    © 2025 Unusual Military Aviation Project
</footer>

</body>
</html>
