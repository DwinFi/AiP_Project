<h1 class="mb-4 text-center"><%= title %></h1>

<img
    src="<%= picture %>"
    alt="<%= title %>"
    class="plane-img img-fluid mb-4"
/>

<h3>Описание:</h3>
<p><%= desc %></p>

<% if (typeof flight !== 'undefined') { %>
<h3 class="mt-4">Лётные характеристики</h3>
<table class="table table-dark table-striped table-bordered mt-2">
    <tbody>
        <% for (let key in flight) { %>
            <tr>
                <th><%= key %></th>
                <td><%= flight[key] %></td>
            </tr>
        <% } %>
    </tbody>
</table>
<% } %>

<% if (typeof tech !== 'undefined') { %>
<h3 class="mt-4">Технические характеристики</h3>
<table class="table table-dark table-striped table-bordered mt-2">
    <tbody>
        <% for (let key in tech) { %>
            <tr>
                <th><%= key %></th>
                <td><%= tech[key] %></td>
            </tr>
        <% } %>
    </tbody>
</table>
<% } %>

<a class="btn btn-secondary mt-3" href="/">Назад</a>
