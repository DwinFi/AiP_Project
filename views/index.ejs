<h1 class="text-center mb-4"><%= title %></h1>

<!-- Адаптивная карусель -->
<div id="planesCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">

    <div class="carousel-inner">

        <div class="carousel-item active">
            <img src="/images/bi.png" class="d-block mx-auto" style="max-width:80%; border-radius:14px;" alt="БИ-1">
        </div>

        <div class="carousel-item">
            <img src="/images/ho229.png" class="d-block mx-auto" style="max-width:80%; border-radius:14px;" alt="Ho 229">
        </div>

        <div class="carousel-item">
            <img src="/images/f117.png" class="d-block mx-auto" style="max-width:80%; border-radius:14px;" alt="F-117">
        </div>

    </div>

    <!-- Управление -->
    <button class="carousel-control-prev" type="button" data-bs-target="#planesCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>

    <button class="carousel-control-next" type="button" data-bs-target="#planesCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>

</div>

<p class="text-center mt-4">
    Добро пожаловать! Используйте меню, чтобы перейти к подробной информации о самых необычных военных самолётах.
</p>
