<h1 class="text-center mb-4"><%= title %></h1>

<div class="text-center">
  <img src="<%= avatar %>" class="plane-img mb-4">
</div>

<p class="fs-5 text-center mb-5"><%= desc %></p>

<h3>Лётные характеристики</h3>
<table class="table table-dark table-bordered mb-4">
  <% if (flightSpecs) { %>
    <% for (let key in flightSpecs) { %>
      <tr>
        <th><%= key %></th>
        <td><%= flightSpecs[key] %></td>
      </tr>
    <% } %>
  <% } %>
</table>

<h3>Технические данные</h3>
<table class="table table-dark table-bordered mb-4">
  <% if (technical) { %>
    <% for (let key in technical) { %>
      <tr>
        <th><%= key %></th>
        <td><%= technical[key] %></td>
      </tr>
    <% } %>
  <% } %>
</table>

<h3>Вооружение</h3>
<p><%= armament %></p>
